# Private server-side values only. Enter real values in Vercel or .env.local.
# Prisma runtime: Supabase Connect → Transaction pooler (port 6543).
DATABASE_URL=
# Local Prisma CLI/Studio: Session pooler (port 5432) or direct connection.
DIRECT_URL=
# Supabase Auth and server-side team administration; Data API storage compatibility.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase Auth uses a publishable key, kept server-side by this app.
SUPABASE_PUBLISHABLE_KEY=
# Legacy staff email allowlist; trusted AXIC app metadata can also grant access.
OPERATIONS_ALLOWED_EMAILS=

# Initial/owner admin email(s). Other allowed emails default to staff.
OPERATIONS_ADMIN_EMAILS=
