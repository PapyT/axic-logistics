// Map existing AXIC tables without renaming or copying their data.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model Shipment {
  id      String @id @db.Text
  payload Json   @db.JsonB
  version Int    @default(0)
  consignment Consignment?
  @@map("axic_shipments")
}
model SupportTicket {
  id      String   @id @db.Text
  subject String   @db.Text
  message String   @db.Text
  status  String   @default("Open") @db.Text
  created DateTime @default(now()) @db.Timestamptz(6)
  @@index([created(sort: Desc)], map: "axic_tickets_created_idx")
  @@map("axic_tickets")
}

model Consignment {
  workflow Workflow?
  id String @id @db.Text
  shipmentId String @unique @map("shipment_id") @db.Text
  shipment Shipment @relation(fields:[shipmentId], references:[id])
  sender Json @db.JsonB
  receiver Json @db.JsonB
  created DateTime @default(now()) @db.Timestamptz(6)
  goods Good[]
  @@index([created(sort:Desc)], map:"axic_consignments_created_idx")
  @@map("axic_consignments")
}
model Good {
  scans WorkflowScan[]
  receipts Receipt[]
  id String @id @db.Uuid
  description String @db.Text
  weight Float
  consignmentId String? @map("consignment_id") @db.Text
  consignment Consignment? @relation(fields:[consignmentId],references:[id])
  created DateTime @default(now()) @db.Timestamptz(6)
  assignedAt DateTime? @map("assigned_at") @db.Timestamptz(6)
  @@index([consignmentId],map:"axic_goods_consignment_idx")
  @@map("axic_goods")
}

model Receipt {
  id String @id @db.Uuid
  goodId String @map("good_id") @db.Uuid
  good Good @relation(fields:[goodId],references:[id])
  location String @db.Text
  locationKey String @map("location_key") @db.Text
  receivedBy String @map("received_by") @db.Uuid
  receivedByName String @map("received_by_name") @db.Text
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  @@unique([goodId,locationKey],map:"axic_receipts_good_id_location_key_key")
  @@index([receivedAt(sort:Desc)],map:"axic_receipts_received_idx")
  @@map("axic_receipts")
}

model Workflow {
  consignmentId String @id @map("consignment_id") @db.Text
  consignment Consignment @relation(fields:[consignmentId],references:[id])
  origin String @db.Text
  destination String @db.Text
  stage String @default("Awaiting pickup") @db.Text
  pickupOwner String? @map("pickup_owner") @db.Uuid
  pickupName String? @map("pickup_name") @db.Text
  destinationOwner String? @map("destination_owner") @db.Uuid
  destinationName String? @map("destination_name") @db.Text
  deliveryOwner String? @map("delivery_owner") @db.Uuid
  deliveryName String? @map("delivery_name") @db.Text
  updated DateTime @default(now()) @db.Timestamptz(6)
  scans WorkflowScan[]
  alerts WorkflowAlert[]
  @@index([origin,stage],map:"axic_workflows_origin_idx")
  @@index([destination,stage],map:"axic_workflows_destination_idx")
  @@map("axic_workflows")
}
model WorkflowScan {
  id String @id @db.Uuid
  goodId String @map("good_id") @db.Uuid
  good Good @relation(fields:[goodId],references:[id])
  consignmentId String @map("consignment_id") @db.Text
  workflow Workflow @relation(fields:[consignmentId],references:[consignmentId])
  phase String @db.Text
  actor String @db.Uuid
  actorName String @map("actor_name") @db.Text
  location String @db.Text
  scannedAt DateTime @default(now()) @map("scanned_at") @db.Timestamptz(6)
  @@unique([goodId,phase],map:"axic_workflow_scans_good_id_phase_key")
  @@index([consignmentId,phase],map:"axic_workflow_scans_consignment_idx")
  @@map("axic_workflow_scans")
}
model WorkflowAlert {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consignmentId String @map("consignment_id") @db.Text
  workflow Workflow @relation(fields:[consignmentId],references:[consignmentId])
  state String @db.Text
  kind String @db.Text
  created DateTime @default(now()) @db.Timestamptz(6)
  reads WorkflowRead[]
  @@index([state,created(sort:Desc)],map:"axic_workflow_alerts_state_idx")
  @@map("axic_workflow_alerts")
}
model WorkflowRead {
  alertId String @map("alert_id") @db.Uuid
  alert WorkflowAlert @relation(fields:[alertId],references:[id])
  actor String @db.Uuid
  @@id([alertId,actor])
  @@map("axic_workflow_reads")
}

model QuoteRequest {
  id String @id @db.Text
  payload Json @db.JsonB
  created DateTime @default(now()) @db.Timestamptz(6)
  @@index([created(sort: Desc)], map: "axic_quote_requests_created_idx")
  @@map("axic_quote_requests")
}
