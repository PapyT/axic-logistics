// Map existing AXIC tables without renaming or copying their data.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model Shipment {
  id      String @id @db.Text
  payload Json   @db.JsonB
  version Int    @default(0)
  consignment Consignment?
  @@map("axic_shipments")
}
model SupportTicket {
  id      String   @id @db.Text
  subject String   @db.Text
  message String   @db.Text
  status  String   @default("Open") @db.Text
  created DateTime @default(now()) @db.Timestamptz(6)
  @@index([created(sort: Desc)], map: "axic_tickets_created_idx")
  @@map("axic_tickets")
}

model Consignment {
  id String @id @db.Text
  shipmentId String @unique @map("shipment_id") @db.Text
  shipment Shipment @relation(fields:[shipmentId], references:[id])
  sender Json @db.JsonB
  receiver Json @db.JsonB
  created DateTime @default(now()) @db.Timestamptz(6)
  goods Good[]
  @@index([created(sort:Desc)], map:"axic_consignments_created_idx")
  @@map("axic_consignments")
}
model Good {
  receipts Receipt[]
  id String @id @db.Uuid
  description String @db.Text
  weight Float
  consignmentId String? @map("consignment_id") @db.Text
  consignment Consignment? @relation(fields:[consignmentId],references:[id])
  created DateTime @default(now()) @db.Timestamptz(6)
  assignedAt DateTime? @map("assigned_at") @db.Timestamptz(6)
  @@index([consignmentId],map:"axic_goods_consignment_idx")
  @@map("axic_goods")
}

model Receipt {
  id String @id @db.Uuid
  goodId String @map("good_id") @db.Uuid
  good Good @relation(fields:[goodId],references:[id])
  location String @db.Text
  locationKey String @map("location_key") @db.Text
  receivedBy String @map("received_by") @db.Uuid
  receivedByName String @map("received_by_name") @db.Text
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  @@unique([goodId,locationKey],map:"axic_receipts_good_id_location_key_key")
  @@index([receivedAt(sort:Desc)],map:"axic_receipts_received_idx")
  @@map("axic_receipts")
}
